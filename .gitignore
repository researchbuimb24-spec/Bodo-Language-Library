# Databases and archives
*.zip
*.sqlite
*.db
data/*.csv
data/english_words.txt
data/export_*/
data/raw_datasets/

# Data archive directories
data/archive/*/books/
data/archive/*/folk_songs/
data/archive/*/datasets/

# Consents and sensitive documentation
consents/

# Audio and media recordings
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.mp4

# Keep culture, history, and book documentation files tracked
!data/archive/*/culture/*.md
!data/archive/*/history/*.md
!data/archive/*/books/README.txt

# Python caches, environments, and build artifacts
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Testing & Linting
.pytest_cache
.ruff_cache
.coverage
htmlcov/
